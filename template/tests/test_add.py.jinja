import pytest

from {{ package_name }} import add


@pytest.mark.parametrize(
    ("left", "right", "expected"),
    [(1, 2, 3), (-5, 5, 0), (0, 0, 0)],
)
def test_add_returns_sum(left: int, right: int, expected: int) -> None:
    assert add(left, right) == expected
