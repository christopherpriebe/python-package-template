//! This crate has no Python dependencies. The `{{ crate_name }}-py` crate wraps it
//! for Python.

/// Errors returned by this crate.
#[derive(Debug, Clone, Copy, PartialEq, Eq, thiserror::Error)]
#[non_exhaustive]
pub enum Error {
    /// The result of an arithmetic operation does not fit in the output type.
    #[error("integer overflow")]
    Overflow,
}

/// Adds two signed 64-bit integers.
///
/// # Errors
///
/// Returns [`Error::Overflow`] if the sum does not fit in an `i64`.
pub fn add(left: i64, right: i64) -> Result<i64, Error> {
    left.checked_add(right).ok_or(Error::Overflow)
}

#[cfg(test)]
mod tests {
    use super::{Error, add};

    #[test]
    fn add_returns_sum() {
        assert_eq!(add(2, 3), Ok(5));
    }

    #[test]
    fn add_reports_overflow() {
        assert_eq!(add(i64::MAX, 1), Err(Error::Overflow));
    }
}
