[workspace]
resolver = "3"
members = ["crates/*"]

[workspace.package]
version = "0.1.0"
edition = "2024"
authors = ["{{ author_name }} <{{ author_email }}>"]
{%- if license != "Proprietary" %}
license = "{{ license }}"
{%- endif %}
{%- if github_owner %}
repository = "https://github.com/{{ github_owner }}/{{ project_slug }}"
{%- endif %}
publish = false

[workspace.dependencies]
{{ crate_name }} = { path = "crates/{{ crate_name }}" }
pyo3 = { version = "0.30", features = ["abi3-py{{ python_min | replace('.', '') }}"] }

[workspace.lints.rust]
missing_docs = "warn"
unreachable_pub = "warn"
unsafe_code = "deny"
unused_qualifications = "warn"

[workspace.lints.clippy]
pedantic = { level = "warn", priority = -1 }
dbg_macro = "warn"
expect_used = "warn"
panic = "warn"
todo = "warn"
unimplemented = "warn"
unwrap_used = "warn"

[profile.release]
lto = "thin"
codegen-units = 1
